<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pay to Tanishq</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #fafafa;
            margin: 0;
            padding: 0;
        }
        h1 {
            color: #333;
            margin-top: 20px;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 40px;
            margin: 40px auto;
            max-width: 900px;
        }
        .section {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
            width: 400px;
        }
        .section h2 {
            color: #444;
        }
        .link {
            display: block;
            margin: 12px 0;
            padding: 12px;
            background: #ff9800;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: background 0.3s ease;
        }
        .link:hover {
            background: #e68900;
        }
    </style>
</head>
<body>
    <h1>Pay to Tanishq</h1>
    <div class="container">

        <!-- Domestic Payments -->
        <div class="section">
            <h2>Domestic (India)</h2>
            <!-- Generic UPI -->
            <a class="link" href="upi://pay?pa=8827514415@idfcfirst&pn=Tanishq&cu=INR">Pay via UPI (Any App)</a>
            <!-- BHIM -->
            <a class="link" href="bhim://pay?pa=8827514415@idfcfirst&pn=Tanishq&cu=INR">Pay via BHIM</a>
            <!-- Google Pay -->
            <a class="link" href="gpay://upi/pay?pa=8827514415@idfcfirst&pn=Tanishq&cu=INR">Pay via Google Pay</a>
            <!-- PhonePe -->
            <a class="link" href="phonepe://pay?pa=8827514415@idfcfirst&pn=Tanishq&cu=INR">Pay via PhonePe</a>
            <!-- Paytm -->
            <a class="link" href="paytmmp://pay?pa=8827514415@idfcfirst&pn=Tanishq&cu=INR">Pay via Paytm</a>
        </div>

        <!-- International Payments -->
        <div class="section">
            <h2>International</h2>
            <a class="link" href="https://paypal.me/TanishqTiwari20" target="_blank">Pay via PayPal</a>
        </div>

    </div>
</body>
</html>
